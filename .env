# Production runtime configuration for build 211+ (RC-BLK-005 closed
# 2026-09-21: api.wellapath.org verified live, /config canonical sha256
# 3b2bbb1c…8578ed, serving approved facilities 1.1).
#
# This file is committed with NON-SECRET values only. Artifact URLs are
# consumed from GET /config and are never constructed from an env base;
# ARTIFACT_BASE_URL is deliberately absent. Developers override locally in
# .env.local (gitignored) for staging work.
API_BASE_URL=https://api.wellapath.org
APP_ENV=production
ENABLE_OFFLINE_MODE=true
API_TIMEOUT_MS=10000

# --- Telemetry (I1/W1) -------------------------------------------------------
# Disabled. TELEMETRY_BASE_URL is deliberately absent (it would fall back to
# API_BASE_URL if telemetry were ever enabled). Production telemetry
# additionally requires TELEMETRY_PRODUCTION_APPROVED=true, which requires
# founder + engineering lead sign-off and is not granted.
TELEMETRY_ENABLED=false
TELEMETRY_PRODUCTION_APPROVED=false
