# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment
# .env holds placeholder values committed for CI asset bundling (see CLAUDE.md).
# Real/local overrides go in .env.local, which stays ignored.
.env.local

# Stray env fragment (no secrets — documentation snippet)
.github/.env

.claude/

# Android release signing — credentials and keystores are never committed
# (LOCKED PRINCIPLE #6). Create android/key.properties locally from the
# founder-issued keystore; see docs/BETA_ROLLBACK.md.
android/key.properties
*.keystore
*.jks

# Sentry symbol-upload credentials: auth token, org and project live ONLY in
# the shell environment or an untracked sentry.properties. Never committed.
sentry.properties
android/sentry.properties
ios/sentry.properties

# Facility source exports — never committed.
#
# The health-facility registry exports used for audit work carry contact
# details for tens of thousands of facilities (the NHFR export alone holds
# ~30,500 telephone numbers and ~7,000 email addresses), and this repository
# is public. They are also large enough to bloat every clone.
#
# Keep the raw exports outside Git entirely and pass the path to the audit
# scripts, either as an argument or through WELLAPATH_PRIVATE_DATA. Only
# derived, contact-free, aggregate artifacts belong in the repository.
nigeria_health_facilities.csv
nhfr_*.csv
grid3_*.csv
facilities_export_*.csv
